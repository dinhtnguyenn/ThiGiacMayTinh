# development | production. Production rejects the default signing secret.
FACEOPS_ENV=development

# Generate a long random value before public deployment.
FACEOPS_SIGNING_SECRET=development-only-change-this-before-public-deploy

# Docker defaults. For local Python, set these to writable host paths.
FACEOPS_DATA_DIR=/data
FACEOPS_DATABASE_PATH=/data/faceops.sqlite3
FACEOPS_MODEL_ROOT=/models

# InsightFace model and matching policy. Calibrate the threshold with your own consented data.
FACEOPS_INSIGHTFACE_MODEL=buffalo_l
FACEOPS_MATCH_THRESHOLD=0.45
FACEOPS_POSE_DELTA_THRESHOLD=0.06

# Public-service privacy controls.
FACEOPS_RETENTION_DAYS=30
FACEOPS_CHALLENGE_TTL_SECONDS=90
FACEOPS_MAX_UPLOAD_BYTES=8388608
