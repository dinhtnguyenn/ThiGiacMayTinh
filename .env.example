# development | production. Production rejects the default signing secret.
FACEOPS_ENV=development

# Generate a long random value before public deployment.
FACEOPS_SIGNING_SECRET=development-only-change-this-before-public-deploy

# Required to list, rename, or delete shared profiles from the Management tab.
# Generate a different long random value for production; never put it in source control.
FACEOPS_ADMIN_TOKEN=

# Docker defaults. For local Python, set these to writable host paths.
FACEOPS_DATA_DIR=/data
FACEOPS_DATABASE_PATH=/data/faceops.sqlite3
FACEOPS_MODEL_ROOT=/models

# Required by Docker Compose. On an existing server, run `docker volume ls` and
# set this to the currently attached volume name before the first CI/CD deploy.
FACEOPS_DATA_VOLUME=faceops-data

# InsightFace model and matching policy. Calibrate the threshold with your own consented data.
FACEOPS_INSIGHTFACE_MODEL=buffalo_l
FACEOPS_DETECTOR_SIZE=512
FACEOPS_MATCH_THRESHOLD=0.45

# Passive anti-spoofing model used for every detected face. The model is
# downloaded once to the persistent /models volume and checksum-verified.
FACEOPS_PAD_MODEL_PATH=/models/pad/minifasnet_v2.onnx
FACEOPS_PAD_MODEL_URL=https://huggingface.co/garciafido/minifasnet-v2-anti-spoofing-onnx/resolve/d29c87568ca9b5662da803b10f217c4db20b142b/minifasnet_v2.onnx
FACEOPS_PAD_MODEL_SHA256=d7b3cd9ba8a7ceb13baa8c4720902e27ca3112eff52f926c08804af6b6eecc7b
# Keep the public workflow usable under ordinary webcam lighting. A spoof is
# blocked only at a much higher confidence; the middle band is "uncertain".
FACEOPS_PAD_LIVE_THRESHOLD=0.55
FACEOPS_PAD_SPOOF_THRESHOLD=0.97

# Enrollment quality gate. Registration frames use 640 px so a 96 px face is
# sufficiently detailed without making ordinary recognition frames slower.
FACEOPS_MIN_FACE_SIZE=96

# Public-service privacy controls.
FACEOPS_RETENTION_DAYS=30
FACEOPS_CHALLENGE_TTL_SECONDS=90
FACEOPS_MAX_UPLOAD_BYTES=8388608
